# ====================================================================
# SMART MEETING ROOM - ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Supabase Project URL & Anonymous Key (Public - Client & Server)
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Service Role Key (CONFIDENTIAL - Server Only, Never expose in client)
# Used for administrative tasks and server-side webhook operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Application URL & Timezone
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TIMEZONE=Asia/Bangkok
